{
  "schema": "btc-external-source-registry-v1",
  "updatedAt": "2026-09-15",
  "policy": {
    "readOnly": true,
    "affectsSafety": false,
    "affectsOrders": false,
    "liveForwardEvidenceSeparate": true,
    "minimumTrustedTier": "A"
  },
  "sources": [
    {
      "id": "binance-public-data",
      "name": "Binance Public Data",
      "repo": "https://github.com/binance/binance-public-data",
      "dataRoot": "https://data.binance.vision",
      "tier": "A",
      "ownerType": "official",
      "markets": ["spot", "um-futures", "cm-futures"],
      "fields": ["kline", "trade", "aggTrade"],
      "use": "PRIMARY_PRICE_HISTORY"
    },
    {
      "id": "github-third-party-catalog",
      "name": "GitHub third-party crypto datasets",
      "repo": "https://github.com/topics/binance-data",
      "tier": "C",
      "ownerType": "community",
      "markets": ["mixed"],
      "fields": ["varies"],
      "use": "REFERENCE_ONLY_UNTIL_SCHEMA_AND_PROVENANCE_PASS"
    }
  ]
}
